# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Tehran

# --- Samad dining API ---
SAMAD_BASE_URL=https://setad.dining.sharif.edu
SAMAD_CLIENT_ID=samad-mobile
# Only needed if the token endpoint requires HTTP Basic auth.
SAMAD_CLIENT_SECRET=
SAMAD_TIMEOUT=20

# --- Watcher ---
# Seconds between polls when running `manage.py watch`.
SOFREH_POLL_INTERVAL=300
SOFREH_LOG_LEVEL=INFO

# --- Bootstrap values for `manage.py sofreh_setup --from-env` ---
# These seed the database once; afterwards the admin is the source of truth.
SAMAD_ACCESS_TOKEN=
SAMAD_REFRESH_TOKEN=
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids (your own id, or a group/channel id).
TELEGRAM_CHAT_IDS=
